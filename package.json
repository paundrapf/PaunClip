{
  "name": "paunclip",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI clipping workspace for YouTube and local videos.",
  "author": "paundrapf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paundrapf/PaunClip.git"
  },
  "bugs": {
    "url": "https://github.com/paundrapf/PaunClip/issues"
  },
  "homepage": "https://github.com/paundrapf/PaunClip#readme",
  "main": "electron/main.cjs",
  "type": "module",
  "bin": {
    "paunclip": "./bin/paunclip.cjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli:dev": "node bin/paunclip.cjs",
    "cli:smoke": "node scripts/smoke-cli.cjs",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:tools": "node scripts/download-ytdlp.cjs",
    "desktop:build": "npm run desktop:tools && npm run build && node scripts/prepare-standalone.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64",
    "desktop:smoke": "node scripts/smoke-desktop-package.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:pipeline": "node --conditions react-server --import tsx scripts/smoke-local-pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@prisma/client": "^6.7.0",
    "@tanstack/react-query": "^5.74.4",
    "@trpc/client": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.503.0",
    "next": "^16.2.2",
    "openai": "^4.96.2",
    "p-queue": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.2.0",
    "tsx": "^4.19.4",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.1",
    "eslint-config-next": "^16.2.2",
    "postcss": "8.5.10",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "build": {
    "appId": "com.paunclip.desktop",
    "productName": "PaunClip",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "electron/**",
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "prisma/**",
      "package.json",
      "!node_modules/**",
      "!storage/**",
      "!.env",
      "!.env.*",
      "!.next/standalone/storage/**",
      "!.next/standalone/.env",
      "!.next/standalone/.env.*",
      "!.next/standalone/**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
